<!--
    Every icon below is tinted at draw time - Icon.draw hands :tintColor to
    drawBitmap2 - so each one is packed as PNG. Left alone the resource
    compiler converts a bitmap to the device's native format, which carries a
    palette, and drawBitmap2 rejects a palettized source with "Source must not
    use a color palette". LauncherIcon is drawn by the system and never
    tinted, so it keeps the default packing.
-->
<drawables xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <bitmap id="LauncherIcon" filename="launcher_icon.png" />

