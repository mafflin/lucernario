<!--
    Every icon below is tinted at draw time - Icon.paint hands :tintColor to
    drawBitmap2 - so each one is packed as PNG. Left alone the resource
    compiler converts a bitmap to the device's native format, which carries a
    palette, and drawBitmap2 rejects a palettized source with "Source must not
    use a color palette". LauncherIcon is drawn by the system and never
    tinted, so it keeps the default packing.
-->
<drawables xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <bitmap id="LauncherIcon" filename="launcher_icon.png" />

    <bitmap id="Alarm" filename="alarm/alarm.png" packingFormat="png" />
    <bitmap id="Phone" filename="phone/phone.png" packingFormat="png" />

    <bitmap id="Battery0" filename="battery/battery_0.png" packingFormat="png" />
    <bitmap id="Battery10" filename="battery/battery_10.png" packingFormat="png" />
    <bitmap id="Battery20" filename="battery/battery_20.png" packingFormat="png" />
    <bitmap id="Battery30" filename="battery/battery_30.png" packingFormat="png" />
    <bitmap id="Battery40" filename="battery/battery_40.png" packingFormat="png" />
    <bitmap id="Battery50" filename="battery/battery_50.png" packingFormat="png" />
    <bitmap id="Battery60" filename="battery/battery_60.png" packingFormat="png" />
    <bitmap id="Battery70" filename="battery/battery_70.png" packingFormat="png" />
    <bitmap id="Battery80" filename="battery/battery_80.png" packingFormat="png" />
    <bitmap id="Battery90" filename="battery/battery_90.png" packingFormat="png" />
    <bitmap id="Battery100" filename="battery/battery_100.png" packingFormat="png" />

    <bitmap id="Am" filename="meridiem/am.png" packingFormat="png" />
    <bitmap id="Pm" filename="meridiem/pm.png" packingFormat="png" />
</drawables>
