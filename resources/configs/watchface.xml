<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <watchface-config>
        <!-- Ids must match the Styles module in source/app/Styles.mc -->
        <styles>
            <style id="1" label="@Strings.styleNumerals" default="true"/>
            <style id="2" label="@Strings.stylePlain"/>
        </styles>
        <!-- An explicit palette rather than allowAny: the editor wants a
             label per color, and with allowAny the fenix 8 Solar filled its
             picker with garbled entries.

             Every channel is 00, 55, AA or FF - the 64 color MIP palette -
             so none of these dither on those screens. No black: the
             background is black.

             Accent colors the hands; data colors the time, the status row
             and the data fields, and the rim until the sun is known. -->
        <accentColors>
            <color label="@Strings.ColorWhite" default="true">0xFFFFFF</color>
            <color label="@Strings.ColorGray">0xAAAAAA</color>
            <color label="@Strings.ColorDarkGray">0x555555</color>
            <color label="@Strings.ColorLightRed">0xFF5555</color>
            <color label="@Strings.ColorRed">0xFF0000</color>
            <color label="@Strings.ColorDarkRed">0xAA0000</color>
            <color label="@Strings.ColorOrange">0xFF5500</color>
            <color label="@Strings.ColorLightAmber">0xFFAA55</color>
            <color label="@Strings.ColorAmber">0xFFAA00</color>
            <color label="@Strings.ColorDarkAmber">0xAA5500</color>
            <color label="@Strings.ColorLightYellow">0xFFFF55</color>
            <color label="@Strings.ColorYellow">0xFFFF00</color>
            <color label="@Strings.ColorDarkYellow">0xAAAA00</color>
            <color label="@Strings.ColorLightGreen">0x55FF55</color>
            <color label="@Strings.ColorGreen">0x00FF00</color>
            <color label="@Strings.ColorDarkGreen">0x00AA00</color>
            <color label="@Strings.ColorMint">0x00FFAA</color>
            <color label="@Strings.ColorCyan">0x00FFFF</color>
            <color label="@Strings.ColorDarkCyan">0x00AAAA</color>
            <color label="@Strings.ColorSky">0x00AAFF</color>
            <color label="@Strings.ColorDarkSky">0x0055AA</color>
            <color label="@Strings.ColorLightBlue">0x5555FF</color>
            <color label="@Strings.ColorBlue">0x0000FF</color>
            <color label="@Strings.ColorDarkBlue">0x0000AA</color>
            <color label="@Strings.ColorViolet">0xAA00FF</color>
            <color label="@Strings.ColorLightMagenta">0xFF55FF</color>
            <color label="@Strings.ColorMagenta">0xFF00FF</color>
            <color label="@Strings.ColorDarkMagenta">0xAA00AA</color>
            <color label="@Strings.ColorPink">0xFF00AA</color>
        </accentColors>
        <dataColors>
            <color label="@Strings.ColorWhite" default="true">0xFFFFFF</color>
            <color label="@Strings.ColorGray">0xAAAAAA</color>
            <color label="@Strings.ColorDarkGray">0x555555</color>
            <color label="@Strings.ColorLightRed">0xFF5555</color>
            <color label="@Strings.ColorRed">0xFF0000</color>
            <color label="@Strings.ColorDarkRed">0xAA0000</color>
            <color label="@Strings.ColorOrange">0xFF5500</color>
            <color label="@Strings.ColorLightAmber">0xFFAA55</color>
            <color label="@Strings.ColorAmber">0xFFAA00</color>
            <color label="@Strings.ColorDarkAmber">0xAA5500</color>
            <color label="@Strings.ColorLightYellow">0xFFFF55</color>
            <color label="@Strings.ColorYellow">0xFFFF00</color>
            <color label="@Strings.ColorDarkYellow">0xAAAA00</color>
            <color label="@Strings.ColorLightGreen">0x55FF55</color>
            <color label="@Strings.ColorGreen">0x00FF00</color>
            <color label="@Strings.ColorDarkGreen">0x00AA00</color>
            <color label="@Strings.ColorMint">0x00FFAA</color>
            <color label="@Strings.ColorCyan">0x00FFFF</color>
            <color label="@Strings.ColorDarkCyan">0x00AAAA</color>
            <color label="@Strings.ColorSky">0x00AAFF</color>
            <color label="@Strings.ColorDarkSky">0x0055AA</color>
            <color label="@Strings.ColorLightBlue">0x5555FF</color>
            <color label="@Strings.ColorBlue">0x0000FF</color>
            <color label="@Strings.ColorDarkBlue">0x0000AA</color>
            <color label="@Strings.ColorViolet">0xAA00FF</color>
            <color label="@Strings.ColorLightMagenta">0xFF55FF</color>
            <color label="@Strings.ColorMagenta">0xFF00FF</color>
            <color label="@Strings.ColorDarkMagenta">0xAA00AA</color>
            <color label="@Strings.ColorPink">0xFF00AA</color>
        </dataColors>
        <!-- Ids must match the SlotId module in source/complications/SlotId.mc

             The types are listed rather than allowAny: the editor offers
             exactly these, in this order. The slots are the data fields
             left and right; the right one defaults to the weekday and
             date.
             The weather type shows the temperature beside an icon for the
             conditions that WeatherIcon picks, and the sunset stands for the
             sun's next turn, sunset or sunrise.
             The comment on each line is the icon FieldKinds gives it - the
             two lists are meant to stay in step, so a type dropped here
             should lose its case there as well. -->
        <data>
            <complication id="1">
                <type>Complications.COMPLICATION_TYPE_ALTITUDE</type>                         <!-- altitude -->
                <type>Complications.COMPLICATION_TYPE_BATTERY</type>                          <!-- battery -->
                <type>Complications.COMPLICATION_TYPE_BODY_BATTERY</type>                     <!-- human -->
                <type>Complications.COMPLICATION_TYPE_CALORIES</type>                         <!-- calories -->
                <type>Complications.COMPLICATION_TYPE_CURRENT_TEMPERATURE</type>              <!-- thermometer -->
                <type>Complications.COMPLICATION_TYPE_CURRENT_WEATHER</type>                  <!-- conditions -->
                <type>Complications.COMPLICATION_TYPE_DATE</type>                             <!-- no icon -->
                <type>Complications.COMPLICATION_TYPE_WEEKDAY_MONTHDAY</type>                 <!-- no icon -->
                <type>Complications.COMPLICATION_TYPE_HEART_RATE</type>                       <!-- heart -->
                <type>Complications.COMPLICATION_TYPE_HIGH_LOW_TEMPERATURE</type>             <!-- thermometer -->
                <type>Complications.COMPLICATION_TYPE_INTENSITY_MINUTES</type>                <!-- timer -->
                <type>Complications.COMPLICATION_TYPE_NOTIFICATION_COUNT</type>               <!-- notifications -->
                <type>Complications.COMPLICATION_TYPE_RECOVERY_TIME</type>                    <!-- recovery -->
                <type default="true">Complications.COMPLICATION_TYPE_STEPS</type>             <!-- steps -->
                <type>Complications.COMPLICATION_TYPE_SUNSET</type>                           <!-- sunset or sunrise -->
                <type>Complications.COMPLICATION_TYPE_WEEKLY_BIKE_DISTANCE</type>             <!-- bike -->
                <type>Complications.COMPLICATION_TYPE_WEEKLY_RUN_DISTANCE</type>              <!-- run -->
            </complication>
            <complication id="2">
                <type>Complications.COMPLICATION_TYPE_ALTITUDE</type>                         <!-- altitude -->
                <type>Complications.COMPLICATION_TYPE_BATTERY</type>                          <!-- battery -->
                <type>Complications.COMPLICATION_TYPE_BODY_BATTERY</type>                     <!-- human -->
                <type>Complications.COMPLICATION_TYPE_CALORIES</type>                         <!-- calories -->
                <type>Complications.COMPLICATION_TYPE_CURRENT_TEMPERATURE</type>              <!-- thermometer -->
                <type>Complications.COMPLICATION_TYPE_CURRENT_WEATHER</type>                  <!-- conditions -->
                <type>Complications.COMPLICATION_TYPE_DATE</type>                             <!-- no icon -->
                <type default="true">Complications.COMPLICATION_TYPE_WEEKDAY_MONTHDAY</type>  <!-- no icon -->
                <type>Complications.COMPLICATION_TYPE_HEART_RATE</type>                       <!-- heart -->
                <type>Complications.COMPLICATION_TYPE_HIGH_LOW_TEMPERATURE</type>             <!-- thermometer -->
                <type>Complications.COMPLICATION_TYPE_INTENSITY_MINUTES</type>                <!-- timer -->
                <type>Complications.COMPLICATION_TYPE_NOTIFICATION_COUNT</type>               <!-- notifications -->
                <type>Complications.COMPLICATION_TYPE_RECOVERY_TIME</type>                    <!-- recovery -->
                <type>Complications.COMPLICATION_TYPE_STEPS</type>                            <!-- steps -->
                <type>Complications.COMPLICATION_TYPE_SUNSET</type>                           <!-- sunset or sunrise -->
                <type>Complications.COMPLICATION_TYPE_WEEKLY_BIKE_DISTANCE</type>             <!-- bike -->
                <type>Complications.COMPLICATION_TYPE_WEEKLY_RUN_DISTANCE</type>              <!-- run -->
            </complication>
        </data>
    </watchface-config>
</resources>
