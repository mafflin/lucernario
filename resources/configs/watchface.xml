<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <watchface-config>
        <!-- Ids must match the Styles module in source/Styles.mc -->
        <styles>
            <style id="1" label="@Strings.styleDark" default="true"/>
            <style id="2" label="@Strings.styleLight"/>
        </styles>
        <!-- An explicit palette rather than allowAny: the editor wants a
             label per color, and with allowAny the fenix 8 Solar filled its
             picker with garbled entries.

             The list is the electric watch face's. Every channel is 00, 55,
             AA or FF - the 64 color MIP palette - so none of these dither on
             those screens. Black is added for the light style, which
             electric has no need of.

             Accent colors the seconds hand, data everything else. -->
        <accentColors>
            <color label="@Strings.ColorWhite" default="true">0xFFFFFF</color>
            <color label="@Strings.ColorGray">0xAAAAAA</color>
            <color label="@Strings.ColorDarkGray">0x555555</color>
            <color label="@Strings.ColorBlack">0x000000</color>
            <color label="@Strings.ColorLightRed">0xFF5555</color>
            <color label="@Strings.ColorRed">0xFF0000</color>
            <color label="@Strings.ColorDarkRed">0xAA0000</color>
            <color label="@Strings.ColorOrange">0xFF5500</color>
            <color label="@Strings.ColorLightAmber">0xFFAA55</color>
            <color label="@Strings.ColorAmber">0xFFAA00</color>
            <color label="@Strings.ColorDarkAmber">0xAA5500</color>
            <color label="@Strings.ColorLightYellow">0xFFFF55</color>
            <color label="@Strings.ColorYellow">0xFFFF00</color>
            <color label="@Strings.ColorDarkYellow">0xAAAA00</color>
            <color label="@Strings.ColorLightGreen">0x55FF55</color>
            <color label="@Strings.ColorGreen">0x00FF00</color>
            <color label="@Strings.ColorDarkGreen">0x00AA00</color>
            <color label="@Strings.ColorMint">0x00FFAA</color>
            <color label="@Strings.ColorCyan">0x00FFFF</color>
            <color label="@Strings.ColorDarkCyan">0x00AAAA</color>
            <color label="@Strings.ColorSky">0x00AAFF</color>
            <color label="@Strings.ColorDarkSky">0x0055AA</color>
            <color label="@Strings.ColorLightBlue">0x5555FF</color>
            <color label="@Strings.ColorBlue">0x0000FF</color>
            <color label="@Strings.ColorDarkBlue">0x0000AA</color>
            <color label="@Strings.ColorViolet">0xAA00FF</color>
            <color label="@Strings.ColorLightMagenta">0xFF55FF</color>
            <color label="@Strings.ColorMagenta">0xFF00FF</color>
            <color label="@Strings.ColorDarkMagenta">0xAA00AA</color>
            <color label="@Strings.ColorPink">0xFF00AA</color>
        </accentColors>
        <dataColors>
            <color label="@Strings.ColorWhite" default="true">0xFFFFFF</color>
            <color label="@Strings.ColorGray">0xAAAAAA</color>
            <color label="@Strings.ColorDarkGray">0x555555</color>
            <color label="@Strings.ColorBlack">0x000000</color>
            <color label="@Strings.ColorLightRed">0xFF5555</color>
            <color label="@Strings.ColorRed">0xFF0000</color>
            <color label="@Strings.ColorDarkRed">0xAA0000</color>
            <color label="@Strings.ColorOrange">0xFF5500</color>
            <color label="@Strings.ColorLightAmber">0xFFAA55</color>
            <color label="@Strings.ColorAmber">0xFFAA00</color>
            <color label="@Strings.ColorDarkAmber">0xAA5500</color>
            <color label="@Strings.ColorLightYellow">0xFFFF55</color>
            <color label="@Strings.ColorYellow">0xFFFF00</color>
            <color label="@Strings.ColorDarkYellow">0xAAAA00</color>
            <color label="@Strings.ColorLightGreen">0x55FF55</color>
            <color label="@Strings.ColorGreen">0x00FF00</color>
            <color label="@Strings.ColorDarkGreen">0x00AA00</color>
            <color label="@Strings.ColorMint">0x00FFAA</color>
            <color label="@Strings.ColorCyan">0x00FFFF</color>
            <color label="@Strings.ColorDarkCyan">0x00AAAA</color>
            <color label="@Strings.ColorSky">0x00AAFF</color>
            <color label="@Strings.ColorDarkSky">0x0055AA</color>
            <color label="@Strings.ColorLightBlue">0x5555FF</color>
            <color label="@Strings.ColorBlue">0x0000FF</color>
            <color label="@Strings.ColorDarkBlue">0x0000AA</color>
            <color label="@Strings.ColorViolet">0xAA00FF</color>
            <color label="@Strings.ColorLightMagenta">0xFF55FF</color>
            <color label="@Strings.ColorMagenta">0xFF00FF</color>
            <color label="@Strings.ColorDarkMagenta">0xAA00AA</color>
            <color label="@Strings.ColorPink">0xFF00AA</color>
        </dataColors>
        <!-- Ids must match the FieldLocation module in source/FieldLocation.mc

             The types are listed rather than allowAny: the editor offers
             exactly these, in this order. Steps is the default. The comment
             on each line is the short name ComplicationLabel gives it - the
             two lists are meant to stay in step, so a type dropped here
             should lose its case there as well. -->
        <data>
            <complication id="1">
                <type>Complications.COMPLICATION_TYPE_BATTERY</type>                          <!-- BAT -->
                <type>Complications.COMPLICATION_TYPE_STEPS</type>                            <!-- ST -->
                <type>Complications.COMPLICATION_TYPE_CALORIES</type>                         <!-- CAL -->
                <type>Complications.COMPLICATION_TYPE_FLOORS_CLIMBED</type>                   <!-- FLR -->
                <type>Complications.COMPLICATION_TYPE_INTENSITY_MINUTES</type>                <!-- IM -->
                <type>Complications.COMPLICATION_TYPE_DATE</type>                             <!-- no label -->
                <type default="true">Complications.COMPLICATION_TYPE_WEEKDAY_MONTHDAY</type>  <!-- no label -->
                <type>Complications.COMPLICATION_TYPE_SUNRISE</type>                          <!-- RISE -->
                <type>Complications.COMPLICATION_TYPE_SUNSET</type>                           <!-- SET -->
                <type>Complications.COMPLICATION_TYPE_ALTITUDE</type>                         <!-- ALT -->
                <type>Complications.COMPLICATION_TYPE_SEA_LEVEL_PRESSURE</type>               <!-- BAR -->
                <type>Complications.COMPLICATION_TYPE_NOTIFICATION_COUNT</type>               <!-- MSG -->
                <type>Complications.COMPLICATION_TYPE_HEART_RATE</type>                       <!-- HR -->
                <type>Complications.COMPLICATION_TYPE_WEEKLY_RUN_DISTANCE</type>              <!-- RUN -->
                <type>Complications.COMPLICATION_TYPE_WEEKLY_BIKE_DISTANCE</type>             <!-- BIKE -->
                <type>Complications.COMPLICATION_TYPE_RECOVERY_TIME</type>                    <!-- RH -->
                <type>Complications.COMPLICATION_TYPE_STRESS</type>                           <!-- STR -->
                <type>Complications.COMPLICATION_TYPE_BODY_BATTERY</type>                     <!-- BB -->
                <type>Complications.COMPLICATION_TYPE_VO2MAX_RUN</type>                       <!-- VO2R -->
                <type>Complications.COMPLICATION_TYPE_VO2MAX_BIKE</type>                      <!-- VO2B -->
                <type>Complications.COMPLICATION_TYPE_TRAINING_STATUS</type>                  <!-- no label -->
                <type>Complications.COMPLICATION_TYPE_PULSE_OX</type>                         <!-- SPO2 -->
                <type>Complications.COMPLICATION_TYPE_RESPIRATION_RATE</type>                 <!-- RESP -->
                <type>Complications.COMPLICATION_TYPE_SOLAR_INPUT</type>                      <!-- SOL -->
                <type>Complications.COMPLICATION_TYPE_CURRENT_TEMPERATURE</type>              <!-- TEMP -->
                <type>Complications.COMPLICATION_TYPE_HIGH_LOW_TEMPERATURE</type>             <!-- no label -->
            </complication>
        </data>
    </watchface-config>
</resources>
