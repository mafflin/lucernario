import Toybox.Lang;

//! Colors the code names. Repeated from watchface.xml, which the code cannot
//! read a value out of, so the two must stay in step. All 64 color MIP safe.
module Palette {
    const AMBER = 0xFFAA00;
    const DARK_AMBER = 0xAA5500;
    const SKY = 0x00AAFF;
    const DARK_SKY = 0x0055AA;
}
